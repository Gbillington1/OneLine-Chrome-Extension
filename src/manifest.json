{
    "manifest_version": 3,
    "name": "OneLine v2",
    "version": "2.0",
    "description": "Strengthen your reading OneLine at a time.",    
    "permissions": [
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "background": {
        "service_worker": "js/background/sw.js"
    },
    "icons": {
        "48": "images/icon48.png",
        "128": "images/icon128.png"
    },
    "action": {
        "default_title": "OneLine",
        "default_popup": "html/defaultPopup.html",
        "default_icon": {
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "content_scripts":[{
    "js": [
        "js/libraries/Readability.js",
        "js/libraries/splitting.min.js", 
        "js/libraries/jquery-3.4.1.min.js",
        "js/modules/Line.js",
        "js/modules/Paragraph.js",
        "js/modules/ParagraphController.js",
        "js/modules/OneLine.js",
        "js/OneLine-Main.js"
    ],
    "css": [
        "css/style.css",
        "css/tailwind/out.css"
    ],
    "web_accessible_resources": [
        "html/blobs/*.html"
    ],
    "matches": [
        "http://*/*", 
        "https://*/*",
        "file://*/*"
    ],
    "exclude_globs": ["*://*.google.com/search?*", "*://*.google.com/scholar?*"]
    }]

}