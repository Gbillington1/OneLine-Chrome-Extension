{
    "manifest_version": 3,
    "name": "OneLine",
    "version": "2.0.1",
    "description": "Focus on the words that matter.",    
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "cookies"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "background": {
        "service_worker": "./dist/background.bundle.js"
    },
    "icons": {
        "48": "./src/images/icon48.png",
        "128": "./src/images/icon128.png"
    },
    "action": {
        "default_title": "OneLine",
        "default_popup": "./src/html/defaultPopup.html",
        "default_icon": {
            "48": "./src/images/icon48.png",
            "128": "./src/images/icon128.png"
        }
    },
    "content_scripts":[{
        "js": ["./dist/contentScript.bundle.js"],
        "css": ["./src/css/style.css"],
        "matches": [
            "http://*/*",
            "https://*/*",
            "file://*/*"
        ],
        "exclude_globs": [
            "*://*.google.com/search?*",
            "*://*.google.com/scholar?*"
        ]
    }]
}