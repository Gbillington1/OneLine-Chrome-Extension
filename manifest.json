{
    "manifest_version": 3,
    "name": "OneLine",
    "version": "2.0.1",
    "description": "Focus on the words that matter.",    
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "cookies"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "background": {
        "service_worker": "./dist/js/background.bundle.js"
    },
    "icons": {
        "48": "./dist/images/icon48.png",
        "128": "./dist/images/icon128.png"
    },
    "action": {
        "default_title": "OneLine",
        "default_icon": {
            "48": "./dist/images/icon48.png",
            "128": "./dist/images/icon128.png"
        }
    },
    "content_scripts":[{
        "js": ["./dist/js/contentScript.bundle.js"],
        "css": ["./dist/css/style.css"],
        "matches": [
            "http://*/*",
            "https://*/*",
            "file://*/*"
        ],
        "exclude_globs": [
            "*://*.google.com/search?*",
            "*://*.google.com/scholar?*",
            "*://accounts.google.com/o/oauth2*",
            "*://*.auth0.com/u/login?*"
        ]
    }]
}